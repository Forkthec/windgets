{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windgets",
  "version": "0.1.0",
  "identifier": "com.forktech.windgets",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Windgets",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../assets/templates/default/": "assets/templates/default/",
      "../assets/fonts/nunito.woff2": "assets/fonts/nunito.woff2"
    },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "template": "../../../installer/installer.nsi"
      }
    }
  }
}
